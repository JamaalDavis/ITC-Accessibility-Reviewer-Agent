{
  "name": "accessibility-reviewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve-design-system.mjs",
    "test:ui": "node scripts/check-design-system.mjs",
    "start": "tsx scripts/check-validator.ts",
    "review": "tsx src/index.ts",
    "samples": "tsx src/sample-pages.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:scanner": "tsx scripts/check-scanner.ts",
    "test:tools": "tsx scripts/check-custom-tools.ts",
    "test:agent": "tsx scripts/check-agent.ts",
    "catalog:build": "tsx scripts/build-wcag-catalog.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.261",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "accessibility-scanner-mcp": "0.2.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "axe-core": "4.13.0",
    "playwright-core": "1.63.0"
  }
}
